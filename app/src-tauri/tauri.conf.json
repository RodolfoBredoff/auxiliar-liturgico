{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auxiliar Litúrgico",
  "version": "0.3.0",
  "identifier": "com.igreja.auxiliar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auxiliar Litúrgico",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../../python/listen.py": "listen.py",
      "../../python/sync_ref.py": "sync_ref.py",
      "../../python/track_align.py": "track_align.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNzNBQ0I3NzA3MzlGRkMKUldUOG4zTnd0Nnh6a3ZYeG1XWjR4R29FRm5HOFBOU0o4WUx4bHo0N1VTUHBYWEltTTVsd3BwYXcK",
      "endpoints": [
        "https://github.com/RodolfoBredoff/auxiliar-liturgico/releases/latest/download/latest.json"
      ]
    }
  }
}
